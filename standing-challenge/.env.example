# Slack-appen (bot-scopes chat:write + users:read.email). Uten token sendes ingenting.
# SLACK_BOT_TOKEN=xoxb-...
# Kanalen fredagsrapporten postes i (kanal-ID, f.eks. C0123ABCD – boten må være invitert inn)
# SLACK_CHANNEL_ID=
# Vercel Cron sender denne som «Authorization: Bearer …» (sett den i Vercel, ikke bare lokalt)
# CRON_SECRET=
